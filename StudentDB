CREATE TABLE BANK (
    Addr VARCHAR(30) NOT NULL,
    Code INT PRIMARY KEY,
    BankName VARCHAR(30)
);

CREATE TABLE BANKBRANCH (
    Code INT NOT NULL,
    BranchNo INT, 
    Addr VARCHAR(30),
    PRIMARY KEY (BranchNo, Code),
    FOREIGN KEY (Code) REFERENCES BANK(Code)
);

CREATE TABLE LOANS (
    BranchNo INT NOT NULL,
    Code INT NOT NULL,
    LoanNo INT NOT NULL,
    Amount INT NOT NULL,
    LoanType VARCHAR(30),
    PRIMARY KEY (LoanNo), 
    FOREIGN KEY (BranchNo, Code) REFERENCES BANKBRANCH(BranchNo, Code) 
);

CREATE TABLE CUSTOMER (
    Phone INT NOT NULL,
    SSN INT PRIMARY KEY,
    CustomerName VARCHAR(30) NOT NULL,
    Addr VARCHAR(30)
);

CREATE TABLE ACCOUNT (
    BranchNo INT NOT NULL,
    Code INT NOT NULL,
    AccNo INT NOT NULL,
    AccType VARCHAR(30) NOT NULL,
    Balance INT NOT NULL,
    PRIMARY KEY (BranchNo, AccNo),
    FOREIGN KEY (BranchNo, Code) REFERENCES BANKBRANCH(BranchNo, Code)
);

CREATE TABLE CustAcc (
    SSN INT NOT NULL,
    AccNo INT NOT NULL,
    BranchNo INT NOT NULL,
    PRIMARY KEY (SSN, AccNo, BranchNo),
    FOREIGN KEY (SSN) REFERENCES CUSTOMER(SSN),
    FOREIGN KEY (BranchNo, AccNo) REFERENCES ACCOUNT(BranchNo, AccNo)
);

CREATE TABLE CustLoan (
    SSN INT NOT NULL,
    BranchNo INT NOT NULL,
    LoanNo INT NOT NULL,
    PRIMARY KEY (SSN, BranchNo, LoanNo), 
    FOREIGN KEY (SSN) REFERENCES CUSTOMER(SSN), 
    FOREIGN KEY (LoanNo) REFERENCES LOANS(LoanNo) 
);

