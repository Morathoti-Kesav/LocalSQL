    emp_no VARCHAR(10) PRIMARY KEY,
    emp_name VARCHAR(30) NOT NULL,
    emp_addr VARCHAR(100),
    emp_phone VARCHAR(15),
    dept_no VARCHAR(10) NOT NULL,
    dept_name VARCHAR(30),
    job_id VARCHAR(10),
    salary DECIMAL(15,2) DEFAULT 0.00 
 
);

